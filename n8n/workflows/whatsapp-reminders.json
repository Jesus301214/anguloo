@'
{
  "name": "ANGULO - Recordatorios WhatsApp de Citas",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "hours", "hoursInterval": 1 }] } },
      "id": "schedule",
      "name": "Cada 1 hora",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "meetings",
        "options": {}
      },
      "id": "get-meetings",
      "name": "Obtener reuniones hoy",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [500, 300],
      "credentials": { "supabaseApi": { "id": "1", "name": "ANGULO Supabase" } }
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst today = now.toISOString().split('T')[0];\nconst currentHour = now.getHours();\nconst currentMinute = now.getMinutes();\n\nconst upcomingMeetings = $input.all().filter(item => {\n  const meeting = item.json;\n  if (meeting.fecha !== today) return false;\n  if (!meeting.leads?.whatsapp) return false;\n  \n  const [h, m] = (meeting.hora || '00:00').split(':').map(Number);\n  const meetingMinutes = h * 60 + m;\n  const nowMinutes = currentHour * 60 + currentMinute;\n  const diff = meetingMinutes - nowMinutes;\n  \n  return diff > 0 && diff <= 60;\n});\n\nreturn upcomingMeetings.length > 0 ? upcomingMeetings : [];"
      },
      "id": "filter-upcoming",
      "name": "Filtrar proximas 1h",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [750, 300]
    },
    {
      "parameters": {
        "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" }, "combinator": "and", "conditions": [{ "id": "check", "operator": { "type": "number", "operation": "larger" }, "leftValue": "={{ $json.leads.whatsapp ? 1 : 0 }}", "rightValue": 0 }] }
      },
      "id": "check-whatsapp",
      "name": "Tiene WhatsApp?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1000, 300]
    },
    {
      "parameters": {
        "textBody": "=Hola {{ $json.leads?.nombre || 'cliente' }}! 👋\n\nTu cita con ANGULO es hoy a las {{ $json.hora }}. ¿Confirmas asistencia?\n\nResponde SI para confirmar.",
        "operation": "send",
        "phoneNumberId": "={{ $env.WHATSAPP_PHONE_ID }}",
        "recipientPhoneNumber": "={{ $json.leads?.whatsapp }}",
        "additionalFields": { "previewUrl": false }
      },
      "id": "send-whatsapp",
      "name": "Enviar WhatsApp",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [1250, 300],
      "credentials": { "whatsAppApi": { "id": "2", "name": "ANGULO WhatsApp" } }
    },
    {
      "parameters": { "content": "## Recordatorios de Citas ANGULO\n\nEste workflow busca reuniones que ocurren en la proxima hora y envia un recordatorio por WhatsApp al lead.\n\n### Requisitos:\n- Supabase conectado (tabla meetings con JOIN a leads)\n- WhatsApp Business API configurado\n- Programado cada 1 hora", "height": 250, "width": 400 },
      "id": "sticky-note",
      "name": "Nota",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-250, 200]
    }
  ],
  "connections": {
    "Cada 1 hora": { "main": [[{ "node": "Obtener reuniones hoy", "type": "main", "index": 0 }]] },
    "Obtener reuniones hoy": { "main": [[{ "node": "Filtrar proximas 1h", "type": "main", "index": 0 }]] },
    "Filtrar proximas 1h": { "main": [[{ "node": "Tiene WhatsApp?", "type": "main", "index": 0 }]] },
    "Tiene WhatsApp?": { "main": [[{ "node": "Enviar WhatsApp", "type": "main", "index": 0 }], []] },
    "Enviar WhatsApp": { "main": [[]] }
  },
  "pinData": {},
  "meta": { "instanceId": "angulo-whatsapp-reminders-001" }
}
'@